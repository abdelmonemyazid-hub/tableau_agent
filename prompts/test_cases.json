      {"name": "Order Date",    "type": "date",   "role": "dimension"},
      {"name": "Ship Mode",     "type": "string", "role": "dimension"},
      {"name": "Sales",         "type": "float",  "role": "measure"}
    ],
    "question": "Comparer les ventes par mode de livraison",
    "expected": {
      "viz_type": "bar",
      "columns":  ["Ship Mode"],
      "rows":     ["Sales"]
    },
    "rule_triggered": "RULE 7 — DEFAULT (date field ignoré car pas de mot temporel)"
  },
  {
    "id": "TC-10",
    "description": "Piège anti-hallucination : champ inexistant dans la question",
    "fields": [
      {"name": "Region",  "type": "string", "role": "dimension"},
      {"name": "Sales",   "type": "float",  "role": "measure"}
    ],
    "question": "Ventes par ville",
    "expected": {
      "viz_type": "bar",
      "columns":  ["Region"],
      "rows":     ["Sales"]
    },
    "rule_triggered": "RULE 7 — DEFAULT + R1 (City n'existe pas → fallback sur Region)"
